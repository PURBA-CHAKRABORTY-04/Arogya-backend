# ==============================================================================
# Arogya AI — Backend Environment Configuration Example
# ==============================================================================
# Duplicate this file to .env in the Arogya-backend directory and fill in your values:
# cp .env.example .env
#
# DO NOT commit the actual .env file to version control.
# ==============================================================================

# PostgreSQL Connection String (e.g. Neon, Supabase, local PostgreSQL)
# Format: postgresql://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/arogya_db

# JWT Authentication
# Generate a secret key with: openssl rand -hex 32
SECRET_KEY=your-32-character-random-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Email Microservice Endpoint (Arogya-emailservice Vercel deployment or local)
# Local: http://localhost:3001/api
# Production: https://your-emailservice.vercel.app/api
EMAIL_SERVICE_URL=http://localhost:3001/api

# OpenAI API Key (used for Clinical Symptom Triage V10 engine)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Cloudinary — Secure cloud storage for medical records, lab reports, prescriptions
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Unstructured.io API — Medical document parsing and biometric extraction
UNSTRUCTURED_API_KEY=your_unstructured_api_key

# Google Maps API (Optional) — Precise distance computation for doctor matching
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Google Gemini API — Server-side voice triage audio transcription
GEMINI_API_KEY=your_gemini_api_key

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
